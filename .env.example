# Copy this file to .env and fill in what you need. .env is git-ignored; never commit real keys.
# Everything is optional — the app runs without any of these.

# Sportsbook odds for the Crowd Disagreement tab (free key: https://the-odds-api.com, 500 credits/month).
# You can also paste it in the app: Venues → Sports odds feed.
ODDS_API_KEY=your-odds-api-key-here

# Optional tuning (defaults shown)
# PORT=4173
# PROVIDERS=polymarket,polymarket-us,kalshi,predictit,limitless,manifold
# ODDS_SPORTS=americanfootball_nfl
# ODDS_MARKETS=h2h
# ODDS_REFRESH_MIN=120
# BUFFER_CENTS=0.5
# HISTORY_DAYS=30

# Analyst chat engine: auto | claude | ollama | local
# CHAT_ENGINE=auto
# OLLAMA_MODEL=llama3.1
